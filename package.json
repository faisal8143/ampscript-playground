{
  "name": "ampscript-playground",
  "version": "0.2.0",
  "description": "Render, preview and check Salesforce Marketing Cloud AMPscript locally: a JavaScript AMPscript engine, CLI for CI, browser playground and VS Code extension.",
  "main": "src/ampscript.js",
  "files": [
    "src/",
    "bin/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "sync:vscode": "node scripts/sync-vscode.js"
  },
  "keywords": [
    "ampscript",
    "salesforce",
    "marketing-cloud",
    "sfmc",
    "marketing-cloud-next",
    "email",
    "cloudpages",
    "interpreter",
    "cli",
    "lint"
  ],
  "author": "Faisal Irfan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faisal8143/ampscript-playground.git"
  },
  "engines": {
    "node": ">=18"
  },
  "types": "src/ampscript.d.ts",
  "bin": {
    "ampscript": "bin/ampscript.js"
  },
  "exports": {
    ".": {
      "types": "./src/ampscript.d.ts",
      "default": "./src/ampscript.js"
    },
    "./tooling": "./src/tooling.js",
    "./functions": "./src/functions.js",
    "./project-data": "./src/project-data.js",
    "./package.json": "./package.json"
  },
  "homepage": "https://faisal8143.github.io/ampscript-playground/",
  "bugs": {
    "url": "https://github.com/faisal8143/ampscript-playground/issues"
  }
}
